#include <iostream>
#include <winsock2.h>
#include <ws2tcpip.h>

#pragma comment(lib, "ws2_32.lib")

#define PORT 8080

// Estructura idéntica para leer los datos correctamente
struct VehiculoPacket {
    char placa[10];
    char hora[10];
    int celda;
    int esSalida;
};

int main() {
    WSADATA wsaData;
    SOCKET servidor_fd, nuevo_socket;
    struct sockaddr_in direccion;
    int addrlen = sizeof(direccion);

    bool celdasParqueadero[41] = {false}; // Simula las 40 celdas

    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        std::cerr << "[SERVIDOR] Error al inicializar Winsock.\n";
        return 1;
    }

    servidor_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (servidor_fd == INVALID_SOCKET) {
        std::cerr << "[SERVIDOR] Error al crear el socket.\n";
        WSACleanup();
        return 1;
    }

    direccion.sin_family = AF_INET;
    direccion.sin_addr.s_addr = INADDR_ANY;
    direccion.sin_port = htons(PORT);

    if (bind(servidor_fd, (struct sockaddr*)&direccion, sizeof(direccion)) == SOCKET_ERROR) {
        std::cerr << "[SERVIDOR] Error en bind (puerto ocupado).\n";
        closesocket(servidor_fd);
        WSACleanup();
        return 1;
    }

    if (listen(servidor_fd, 3) == SOCKET_ERROR) {
        std::cerr << "[SERVIDOR] Error en listen.\n";
        closesocket(servidor_fd);
        WSACleanup();
        return 1;
    }

    std::cout << "[SERVIDOR] Esperando conexión en el puerto " << PORT << "...\n";

    nuevo_socket = accept(servidor_fd, (struct sockaddr*)&direccion, &addrlen);
    if (nuevo_socket == INVALID_SOCKET) {
        std::cerr << "[SERVIDOR] Error al aceptar la conexión.\n";
        closesocket(servidor_fd);
        WSACleanup();
        return 1;
    }

    std::cout << "[SERVIDOR] ¡Cliente conectado! Escuchando vehículos en tiempo real...\n\n";

    // Bucle constante para recibir paquetes sin cerrar la conexión
    while (true) {
        VehiculoPacket paqueteRecibido;
        
        int valread = recv(nuevo_socket, reinterpret_cast<char*>(&paqueteRecibido), sizeof(VehiculoPacket), 0);
        
        if (valread > 0) {
            int celdaActual = paqueteRecibido.celda;
            
            if (celdaActual >= 1 && celdaActual <= 40) {
                celdasParqueadero[celdaActual] = true;
            }

            // Mostrar explícitamente la placa recibida en la terminal del servidor
            std::cout << "[SERVIDOR RECIBIÓ] Placa: " << paqueteRecibido.placa 
                      << " | Hora: " << paqueteRecibido.hora 
                      << " | Celda Asignada: " << celdaActual << std::endl;
        } else {
            std::cout << "[SERVIDOR] El cliente se ha desconectado.\n";
            break;
        }
    }

    closesocket(nuevo_socket);
    closesocket(servidor_fd);
    WSACleanup();

    return 0;
}
