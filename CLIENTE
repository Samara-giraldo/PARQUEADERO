#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>
#include <winsock2.h>
#include <ws2tcpip.h>
#include <windows.h> // Para la función Sleep

#pragma comment(lib, "ws2_32.lib")

#define PORT 8080

// Estructura para empaquetar la información del vehículo
struct VehiculoPacket {
    char placa[10];
    char hora[10];
    int celda;
    int esSalida;
};

// Función para generar una placa aleatoria (Ej: ABC-123)
void generarPlaca(char* placaDestino) {
    char l1 = 'A' + (rand() % 26);
    char l2 = 'A' + (rand() % 26);
    char l3 = 'A' + (rand() % 26);
    int num = 100 + (rand() % 900);
    sprintf_s(placaDestino, 10, "%c%c%c-%d", l1, l2, l3, num);
}

// Función para obtener la hora actual
void obtenerHoraActual(char* horaDestino) {
    time_t ahora = time(0);
    tm ltm;
    localtime_s(&ltm, &ahora);
    sprintf_s(horaDestino, 10, "%02d:%02d:%02d", ltm.tm_hour, ltm.tm_min, ltm.tm_sec);
}

int main() {
    WSADATA wsaData;
    SOCKET sock = INVALID_SOCKET;
    struct sockaddr_in serv_addr;

    srand(static_cast<unsigned int>(time(0)));

    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        std::cerr << "[CLIENTE] Error al inicializar Winsock.\n";
        return 1;
    }

    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock == INVALID_SOCKET) {
        std::cerr << "[CLIENTE] Error al crear el socket.\n";
        WSACleanup();
        return 1;
    }

    serv_addr.sin_family = AF_INET;
    serv_addr.sin_port = htons(PORT);
    
    // NOTA ETHERNET: Cambia "127.0.0.1" por la IP del PC servidor cuando usen el cable de red.
    serv_addr.sin_addr.s_addr = inet_addr("127.0.0.1"); 

    if (connect(sock, (struct sockaddr*)&serv_addr, sizeof(serv_addr)) == SOCKET_ERROR) {
        std::cerr << "[CLIENTE] No se pudo conectar al servidor. Asegurate de encenderlo primero.\n";
        closesocket(sock);
        WSACleanup();
        return 1;
    }

    std::cout << "[CLIENTE] Conectado exitosamente al servidor. Generando vehículos...\n\n";

    // Bucle continuo para enviar carros cada pocos segundos
    while (true) {
        VehiculoPacket paquete;
        
        generarPlaca(paquete.placa);
        obtenerHoraActual(paquete.hora);
        paquete.celda = 1 + (rand() % 40); // Celda aleatoria entre 1 y 40
        paquete.esSalida = 0;             // Entrada por defecto

        // Enviar la estructura por el socket
        int bytesEnviados = send(sock, reinterpret_cast<char*>(&paquete), sizeof(VehiculoPacket), 0);
        if (bytesEnviados == SOCKET_ERROR) {
            std::cerr << "[CLIENTE] Conexión perdida con el servidor.\n";
            break;
        }

        // Mostrar explícitamente la placa generada en la terminal del cliente
        std::cout << "[CLIENTE ENVIÓ] Placa: " << paquete.placa 
                  << " | Hora: " << paquete.hora 
                  << " | Celda: " << paquete.celda << std::endl;

        // Esperar de 2 a 5 segundos
        int segundosEspera = 2 + (rand() % 4); 
        Sleep(segundosEspera * 1000);
    }

    closesocket(sock);
    WSACleanup();
    return 0;
}
